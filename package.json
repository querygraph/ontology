{
  "name": "@querygraph/ontology",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-neutral topic-ontology engineering: durable normalization, matching, three-tier navigation, cold-start seed, and text extraction",
  "license": "MIT",
  "repository": "github:querygraph/ontology",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./normalization": {
      "types": "./dist/normalization.d.ts",
      "default": "./dist/normalization.js"
    },
    "./matching": {
      "types": "./dist/matching.d.ts",
      "default": "./dist/matching.js"
    },
    "./navigator": {
      "types": "./dist/navigator.d.ts",
      "default": "./dist/navigator.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "default": "./dist/seed.js"
    },
    "./extraction": {
      "types": "./dist/extraction.d.ts",
      "default": "./dist/extraction.js"
    },
    "./package.json": "./package.json",
    "./normalization-core": {
      "types": "./dist/normalization-core.d.mts",
      "default": "./dist/normalization-core.mjs"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    }
  },
  "files": [
    "dist",
    "src",
    "ONTOLOGY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/normalization-core.mjs src/normalization-core.d.mts dist/",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
